{
  "name": "postbote",
  "version": "0.1.0",
  "description": "Self-hosted, Postmark-compatible mail middleware with Postgres queue and upstream SMTP relay",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "biome format --write src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "setup": "tsx src/cli/setup.ts",
    "import": "tsx src/cli/import.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "juice": "^12.2.3",
    "mailparser": "^3.14.3",
    "nodemailer": "^6.10.0",
    "postgres": "^3.4.5",
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/smtp-server": "^3.5.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
