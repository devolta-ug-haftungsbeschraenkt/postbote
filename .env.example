# postbote configuration (Bauplan §5)
# Role: api | worker | smtp | all (default runs everything in one process)
POSTBOTE_ROLE=all
POSTBOTE_HOST=0.0.0.0
POSTBOTE_PORT=3000

# Postgres — the only stateful dependency (queue + message store)
POSTBOTE_DATABASE_URL=postgres://postbote:postbote@localhost:5432/postbote

# First API token created for the default server during bootstrap (hashed in DB)
POSTBOTE_BOOTSTRAP_TOKEN=change-me

# Log level: trace | debug | info | warn | error
POSTBOTE_LOG_LEVEL=info

# SMTP ingress (Bauplan M5): AUTH PLAIN/LOGIN with access/secret credentials
# Comma-separated ports, default 2525,587. Set to empty to disable SMTP.
POSTBOTE_SMTP_PORTS=2525,587
# STARTTLS: paths to PEM key/cert. Without them the ingress runs plain (dev only).
# POSTBOTE_SMTP_TLS_KEY=./certs/smtp-key.pem
# POSTBOTE_SMTP_TLS_CERT=./certs/smtp-cert.pem

# Phase 2 (M8): public base URL for tracking pixel/link redirects.
# Must be reachable by mail clients (not the internal Docker service name).
POSTBOTE_TRACKING_BASE_URL=http://localhost:3000

# Härtung: Requests pro Minute pro Server-Token (0 = aus)
POSTBOTE_RATE_LIMIT_PER_MIN=600
# AES-256-GCM-Key für Secrets at rest (Relay-Passwörter). Unbedingt setzen und
# sicher aufbewahren — ohne Key werden neue Werte im Klartext gespeichert.
# Erzeugen: openssl rand -hex 32
# POSTBOTE_SECRET_KEY=

# --- Auth via OIDC / Logto (wichtiger Zusatz, docs/OIDC.md) -----------------
# both = OIDC-Bearer + statische Tokens | oidc = nur OIDC | token = nur Tokens
POSTBOTE_AUTH_MODE=both
# POSTBOTE_OIDC_ISSUER=https://logto.example.com
# POSTBOTE_OIDC_AUDIENCE=https://api.postbote.internal
# POSTBOTE_OIDC_REQUIRED_SCOPE=postbote:admin
# POSTBOTE_OIDC_SERVER_SLUG=default
# POSTBOTE_OIDC_JWKS_TTL_MS=3600000
# Admin-UI (Runtime-Config im Container):
# POSTBOTE_UI_OIDC_ISSUER=https://logto.example.com
# POSTBOTE_UI_OIDC_CLIENT_ID=<logto-spa-app-id>
# POSTBOTE_UI_OIDC_RESOURCE=https://api.postbote.internal
# POSTBOTE_UI_OIDC_SCOPES=openid,profile,postbote:admin

# Zusätzliche Header für jede Mail (JSON-Array). app01 braucht
# X-Devolta-Signature: skip, damit der Mailcow-Milter keine Signatur anhängt.
# POSTBOTE_DEFAULT_HEADERS=[{"name":"X-Devolta-Signature","value":"skip"}]
# Relay-Fallback, falls smtp.env Host/Port nicht enthält:
# POSTBOTE_RELAY_HOST=mail.devolta.de
# POSTBOTE_RELAY_PORT=587
# POSTBOTE_RELAY_TLS_MODE=starttls

# Demo mode: in-memory store, no Postgres needed (dev only)
# POSTBOTE_DEMO=1
# Demo credentials (fixed): X-Postmark-Server-Token: postbote-demo-token
#   SMTP user: postbote-demo-smtp / pass: postbote-demo-smtp-secret (ports 2525/587)
