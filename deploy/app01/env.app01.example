# app01 Parallel-Deploy (Bauplan §6 / M7)
# Kopieren nach deploy/app01/app01.env und Werte anpassen. NIEMALS committen.

# --- Stack-Identität ---------------------------------------------------------
COMPOSE_PROJECT_NAME=postbote-v2
# Interner Port des v2-Stacks (Legacy bleibt auf 3000)
POSTBOTE_V2_PORT=3002  # 3001 ist auf app01 belegt
POSTBOTE_V2_SMTP_PORT_1=2526
POSTBOTE_V2_SMTP_PORT_2=588
POSTBOTE_IMAGE=ghcr.io/devolta-ug-haftungsbeschraenkt/postbote:latest
POSTBOTE_UI_IMAGE=ghcr.io/devolta-ug-haftungsbeschraenkt/postbote-ui:latest

# --- Netzwerke (Namen auf app01 prüfen: docker network ls) ------------------
COOLIFY_NETWORK=coolify
LOGTO_NETWORK_1=logto_default
LOGTO_NETWORK_2=logto_net2
LOGTO_NETWORK_3=logto_net3
LOGTO_NETWORK_4=logto_net4
# Kommagetrennte Liste für cutover.sh – muss mit den Compose-Netzen übereinstimmen
POSTBOTE_CLIENT_NETWORKS=coolify,logto_default,logto_net2,logto_net3,logto_net4

# --- Container-Namen für den Alias-Swap ------------------------------------
POSTBOTE_V2_CONTAINER=postbote-v2-api-1
POSTBOTE_LEGACY_CONTAINER=postbote
POSTBOTE_ACTIVE_ALIAS=postbote
POSTBOTE_V2_ALIAS=postbote-v2
POSTBOTE_V2_SMTP_ALIAS=postbote-v2-smtp
POSTBOTE_LEGACY_ALIAS=postbote-legacy

# --- Datenbank --------------------------------------------------------------
POSTBOTE_DATABASE_URL=postgres://postbote:postbote@postbote-v2-db:5432/postbote  # Alias im internal-Netz, nicht "postgres"
POSTGRES_PASSWORD=change-me
POSTBOTE_BOOTSTRAP_TOKEN=change-me

# --- SMTP-Ingress -----------------------------------------------------------
POSTBOTE_SMTP_PORTS=2525,587
# POSTBOTE_SMTP_TLS_KEY=/certs/smtp-key.pem
# POSTBOTE_SMTP_TLS_CERT=/certs/smtp-cert.pem

# --- Import-Quellen (auf app01) --------------------------------------------
POSTBOTE_IMPORT_DIR=/opt/postbote
POSTBOTE_IMPORT_SLUG=default
POSTBOTE_IMPORT_STREAM=outbound

# --- Phase 2 (M8): Tracking ------------------------------------------------
# Öffentlich erreichbare Basis-URL für Pixel/Link-Redirects (Browser-Sicht!)
POSTBOTE_TRACKING_BASE_URL=https://postbote.example.com

# --- Härtung ----------------------------------------------------------------
POSTBOTE_RATE_LIMIT_PER_MIN=600
# AES-Key für Relay-Passwörter: stabil halten und backuppen, sonst sind
# verschlüsselte Werte nach einem Wechsel nicht mehr lesbar.
POSTBOTE_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Auth via OIDC / Logto (docs/OIDC.md) -----------------------------------
POSTBOTE_AUTH_MODE=both
POSTBOTE_OIDC_ISSUER=https://logto.example.com
POSTBOTE_OIDC_AUDIENCE=https://api.postbote.internal
POSTBOTE_OIDC_REQUIRED_SCOPE=postbote:admin
POSTBOTE_OIDC_SERVER_SLUG=default
POSTBOTE_UI_OIDC_ISSUER=https://logto.example.com
POSTBOTE_UI_OIDC_CLIENT_ID=CHANGE_ME_LOGTO_SPA_APP_ID
POSTBOTE_UI_OIDC_RESOURCE=https://api.postbote.internal
POSTBOTE_UI_OIDC_SCOPES=openid,profile,postbote:admin

# app01-spezifisch (Mailcow-Signatur-Milter + Relay-Fallback)
POSTBOTE_DEFAULT_HEADERS=[{"name":"X-Devolta-Signature","value":"skip"}]
POSTBOTE_RELAY_HOST=mail.devolta.de
POSTBOTE_RELAY_PORT=587
POSTBOTE_RELAY_TLS_MODE=starttls
POSTBOTE_RELAY_HOSTNAME=mail.devolta.de
POSTBOTE_RELAY_IP=178.63.12.152

# --- Smoke-Tests ------------------------------------------------------------
POSTBOTE_API_BASE=http://localhost:3001
POSTBOTE_ADMIN_TOKEN=change-me
POSTBOTE_SMTP_HOST=127.0.0.1
POSTBOTE_SMTP_PORT=2526
SMOKE_CLIENTS=deploy/app01/smoke/clients.example.json
POSTFIX_LOG_CMD=docker logs postfix --tail 500
DKIM_SELECTOR=default
DKIM_DOMAINS_FILE=deploy/app01/smoke/domains.example.txt

# --- Logto ------------------------------------------------------------------
LOGTO_ENV_FILE=/opt/logto/.env
LOGTO_RESTART_CMD=docker restart logto
LOGTO_FORGOT_PASSWORD_URL=
